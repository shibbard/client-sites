# Vercel → Project → Settings → Environment Variables.
# Never commit real values; none of these may be exposed to the browser.

# Signs the access tokens. 32+ random bytes — generate one with `npm run secret`.
# Rotating this invalidates every live token, so only do it if the secret leaks.
ACCESS_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...         # sk_live_... when going live
STRIPE_WEBHOOK_SECRET=whsec_...       # from the endpoint you create in Stripe

# Resend — sends the 30-day access link. The sending domain needs SPF and DKIM:
# if this mail lands in spam, someone who has just paid cannot get back in.
RESEND_API_KEY=re_...
MAIL_FROM="Home for Holiday <noreply@home-for-holiday.co.uk>"

# Canonical origin, used for Stripe return URLs and the links inside emails.
SITE_URL=https://home-for-holiday.getdigitaldone.co.uk

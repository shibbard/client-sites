# Vercel → Project → Settings → Environment Variables.
# Never commit real values; none of these may be exposed to the browser.

# Supabase — project MUST be created in a UK/EU region (holds customer emails,
# UK data controller, and the region cannot be changed afterwards).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...              # issues/verifies the 6-digit codes
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # SERVER ONLY — bypasses RLS, reads owner_url

# Stripe
STRIPE_SECRET_KEY=sk_test_...         # sk_live_... when going live
STRIPE_WEBHOOK_SECRET=whsec_...       # from the endpoint you create in Stripe

# Canonical origin, used to build Stripe return URLs.
SITE_URL=https://home-for-holiday.getdigitaldone.co.uk

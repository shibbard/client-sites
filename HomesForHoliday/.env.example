# Vercel → Project → Settings → Environment Variables.
# Never commit real values; none of these may be exposed to the browser.

# Signs the access tokens, and keys the stored sign-in codes. 32+ random bytes —
# generate one with `npm run secret`. Rotating this invalidates every live token
# and every code in flight, so only do it if the secret leaks.
ACCESS_SECRET=

# Stripe
# Test mode first: sk_test_... with a test-mode webhook secret. Going live for
# Gary means swapping these three for his account's live values and pointing a
# new webhook endpoint at the same URL — no code changes.
STRIPE_SECRET_KEY=sk_test_...         # sk_live_... when going live
STRIPE_WEBHOOK_SECRET=whsec_...       # from the endpoint you create in Stripe

# Upstash Redis — holds pending sign-in codes for ten minutes, and nothing else.
# REST credentials, not the redis:// URL. Database: hfh-prod-otp (London).
UPSTASH_REDIS_REST_URL=https://obliging-tuna-98582.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Resend — sends the six-digit sign-in code. The sending domain needs SPF and
# DKIM: if this mail lands in spam, someone who has just paid cannot sign in on
# their phone.
RESEND_API_KEY=re_...
MAIL_FROM="Home for Holiday <noreply@home-for-holiday.co.uk>"

# Canonical origin, used for Stripe return URLs and the links inside emails.
SITE_URL=https://home-for-holiday.getdigitaldone.co.uk

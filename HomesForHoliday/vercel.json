{
  "ignoreCommand": "if git diff HEAD~1 --name-only | grep -q '^HomesForHoliday/'; then exit 1; else exit 0; fi",
  "rewrites": [
    { "source": "/go/:slug", "destination": "/api/go/:slug" }
  ],
  "headers": [
    {
      "source": "/go/:slug",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    }
  ]
}

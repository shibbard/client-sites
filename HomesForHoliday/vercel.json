{
  "ignoreCommand": "if git diff HEAD~1 --name-only | grep -q '^HomesForHoliday/'; then exit 1; else exit 0; fi",
  "rewrites": [
    { "source": "/go/:slug", "destination": "/api/go/:slug" }
  ],
  "redirects": [
    { "source": "/lib/:path*", "destination": "/404.html", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/404.html", "permanent": false },
    { "source": "/build/:path*", "destination": "/404.html", "permanent": false },
    { "source": "/properties.csv", "destination": "/404.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/go/:slug",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
